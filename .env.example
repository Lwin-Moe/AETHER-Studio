# Gemini key တစ်ခု သို့မဟုတ် comma ခြား key များ
GEMINI_API_KEYS=your_key_1,your_key_2
GROQ_API_KEYS=your_groq_key

# balanced | quality | economy
AETHER_MODEL_PROFILE=balanced
AETHER_API_TIMEOUT=600
AETHER_MEDIA_TIMEOUT=300
AETHER_FFMPEG_TIMEOUT=3600
AETHER_MAX_ATTEMPTS=3

# System FFmpeg command names သို့မဟုတ် absolute paths
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
